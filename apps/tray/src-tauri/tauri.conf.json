{
  "productName": "MilkBird Tray",
  "version": "0.1.0",
  "identifier": "cn.fordece.milkbird.tray",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "奶鸟俱乐部",
        "width": 420,
        "height": 560,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "shadow": true
      },
      {
        "label": "toast",
        "url": "toast.html",
        "create": false,
        "title": "奶鸟俱乐部通知",
        "width": 344,
        "height": 100,
        "center": false,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; frame-src 'self' data: blob:; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "tray-windows"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../../skills/a2w/SKILL.md": "skills/a2w/SKILL.md",
      "../../../skills/a2w/references/demand-confirmation.md": "skills/a2w/references/demand-confirmation.md",
      "../../../skills/a2w/scripts/a2w_tray.py": "skills/a2w/scripts/a2w_tray.py"
    }
  }
}
