{
  "productName": "MilkBird Tray",
  "version": "0.1.0",
  "identifier": "cn.fordece.milkbird.tray",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "奶鸟俱乐部",
        "width": 460,
        "height": 338,
        "center": true,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": ["result-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"],
    "resources": {
      "../../../skills/a2w/SKILL.md": "skills/a2w/SKILL.md",
      "../../../skills/a2w/scripts/submit.py": "skills/a2w/scripts/submit.py"
    }
  }
}
